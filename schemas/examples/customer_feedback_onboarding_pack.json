{
  "$schema": "../cleandb.schema.json",
  "schema": {
    "version": "1.0.0",
    "dataset_name": "xanhsm_customer_feedback",
    "domain": "feedback",
    "columns": [
      {
        "name": "feedback_id",
        "dtype": "string",
        "nullable": false,
        "description": "Unique feedback record identifier",
        "business_rules": "Must be non-null and unique. Format: FB_RAW_XXXX",
        "tags": [
          "identifier",
          "primary_key"
        ],
        "pii": false
      },
      {
        "name": "customer_id",
        "dtype": "string",
        "nullable": false,
        "description": "Customer account identifier",
        "business_rules": "Must be a valid customer ID",
        "tags": [
          "identifier",
          "customer"
        ],
        "pii": true
      },
      {
        "name": "timestamp",
        "dtype": "datetime",
        "nullable": false,
        "description": "Comment submission timestamp",
        "business_rules": "Must follow ISO-8601 format",
        "tags": [
          "temporal"
        ],
        "pii": false
      },
      {
        "name": "raw_comment_text",
        "dtype": "text",
        "nullable": false,
        "description": "Unstructured Vietnamese feedback text. May contain teen code slang (e.g. 'ko sac dc', 'app lag vl')",
        "business_rules": "Must not be empty. Content may require NLP teen-code normalization before analysis",
        "tags": [
          "text",
          "nlp",
          "feedback"
        ],
        "pii": false
      },
      {
        "name": "extracted_location",
        "dtype": "string",
        "nullable": true,
        "description": "Location entity extracted by NLP (e.g. Vincom Bà Triệu, Royal City, Landmark 81)",
        "business_rules": "Populated by NLP entity extraction pipeline. Null when no location detected",
        "tags": [
          "nlp",
          "entity",
          "location"
        ],
        "pii": false
      },
      {
        "name": "extracted_component",
        "dtype": "string",
        "nullable": true,
        "description": "Component entity extracted by NLP (e.g. Trạm sạc V-GREEN, Pin xe VinFast, Ứng dụng di động)",
        "business_rules": "Populated by NLP entity extraction pipeline. Null when no component detected",
        "tags": [
          "nlp",
          "entity",
          "component"
        ],
        "pii": false
      },
      {
        "name": "extracted_error_type",
        "dtype": "string",
        "nullable": true,
        "description": "Error classification from NLP (e.g. Lỗi thiết bị / Phần cứng trạm sạc, Lỗi ứng dụng di động)",
        "business_rules": "Populated by NLP classification pipeline. Null when no error type detected",
        "tags": [
          "nlp",
          "classification",
          "error"
        ],
        "pii": false
      },
      {
        "name": "severity_level",
        "dtype": "string",
        "nullable": false,
        "description": "Severity rating assigned to the feedback",
        "business_rules": "Allowed values: CRITICAL, WARNING, INFO",
        "tags": [
          "classification",
          "severity"
        ],
        "pii": false
      }
    ]
  },
  "rules": [
    {
      "rule_id": "R001_FEEDBACK_ID_NOT_NULL",
      "target_field": "feedback_id",
      "rule_type": "not_null",
      "rule_expression": "feedback_id IS NOT NULL",
      "severity": "error",
      "action": "quarantine",
      "description": "feedback_id must not be null",
      "status": "proposed",
      "proposed_by": "system"
    },
    {
      "rule_id": "R002_FEEDBACK_ID_UNIQUE",
      "target_field": "feedback_id",
      "rule_type": "unique",
      "rule_expression": "COUNT(*) OVER (PARTITION BY feedback_id) = 1",
      "severity": "error",
      "action": "quarantine",
      "description": "feedback_id must be unique across all records",
      "status": "proposed",
      "proposed_by": "system"
    },
    {
      "rule_id": "R003_CUSTOMER_ID_NOT_NULL",
      "target_field": "customer_id",
      "rule_type": "not_null",
      "rule_expression": "customer_id IS NOT NULL",
      "severity": "error",
      "action": "quarantine",
      "description": "customer_id must not be null",
      "status": "proposed",
      "proposed_by": "system"
    },
    {
      "rule_id": "R004_TIMESTAMP_FORMAT",
      "target_field": "timestamp",
      "rule_type": "format",
      "rule_expression": "TRY_CAST(timestamp AS TIMESTAMP) IS NOT NULL",
      "severity": "error",
      "action": "quarantine",
      "description": "timestamp must follow ISO-8601 format",
      "status": "proposed",
      "proposed_by": "system"
    },
    {
      "rule_id": "R005_RAW_COMMENT_NOT_NULL",
      "target_field": "raw_comment_text",
      "rule_type": "not_null",
      "rule_expression": "raw_comment_text IS NOT NULL",
      "severity": "error",
      "action": "quarantine",
      "description": "raw_comment_text must not be null — empty feedback records have no value",
      "status": "proposed",
      "proposed_by": "system"
    },
    {
      "rule_id": "R006_SEVERITY_FORMAT",
      "target_field": "severity_level",
      "rule_type": "format",
      "rule_expression": "severity_level IN ('CRITICAL', 'WARNING', 'INFO')",
      "severity": "warning",
      "action": "flag",
      "description": "severity_level must be one of: CRITICAL, WARNING, INFO",
      "status": "proposed",
      "proposed_by": "system"
    },
    {
      "rule_id": "R007_TEEN_CODE_DETECTION",
      "target_field": "raw_comment_text",
      "rule_type": "semantic",
      "rule_expression": "TRUE /* requires vietnamese_teen_code_normalizer NLP pipeline */",
      "severity": "info",
      "action": "flag",
      "description": "Detect Vietnamese teen-code slang in feedback text for normalization. Common patterns: 'ko sac dc', 'app lag vl'",
      "evidence": "UIT-VSFC corpus contains extensive Vietnamese teen-code and missing-accent text",
      "confidence": 0.7,
      "status": "proposed",
      "proposed_by": "system"
    }
  ]
}
