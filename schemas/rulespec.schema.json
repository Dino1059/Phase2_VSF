{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RuleSpec",
  "description": "v4 quality rule definition — SQL expression + HITL lifecycle. Aligned with quality_rules DDL.",
  "type": "object",
  "properties": {
    "rule_id": { "type": "string" },
    "rule_name": { "type": "string", "description": "Human-readable rule name" },
    "rule_type": {
      "type": "string",
      "description": "Category: not_null, range, format, cross_field, semantic, custom_sql"
    },
    "rule_expression": {
      "type": "string",
      "description": "SQL boolean expression executable by DuckDB. E.g. 'rating BETWEEN 1 AND 5'"
    },
    "target_field": { "type": "string", "description": "Primary column this rule validates" },
    "description": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["error", "warning", "info"]
    },
    "action": {
      "type": "string",
      "enum": ["quarantine", "flag", "drop", "impute_deterministic"]
    },
    "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "status": {
      "type": "string",
      "enum": ["proposed", "approved", "rejected", "deprecated"],
      "default": "proposed"
    },
    "proposed_by": {
      "type": "string",
      "description": "Agent or actor that proposed this rule (e.g. ProfilerAgent, human)"
    },
    "approved_by": { "type": ["string", "null"], "description": "Who approved this rule" },
    "approved_at": { "type": ["string", "null"], "format": "date-time" },
    "snapshot_id": { "type": "string", "description": "FK to raw_snapshots — which data snapshot this rule was derived from" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "required": ["rule_id", "rule_type", "rule_expression", "status"]
}
