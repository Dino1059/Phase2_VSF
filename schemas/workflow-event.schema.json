{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WorkflowEvent",
  "description": "Canonical steward timeline event (PLAN.md §9). Chat is a projection of these events, not the source of truth.",
  "type": "object",
  "properties": {
    "event_id": { "type": "string" },
    "sequence_number": { "type": "integer", "minimum": 0 },
    "project_id": { "type": "string" },
    "incident_id": { "type": ["string", "null"] },
    "session_id": { "type": ["string", "null"] },
    "entity_ids": { "type": "array", "items": { "type": "string" } },
    "phase": {
      "type": "string",
      "enum": ["INGEST", "PROFILE", "DETECT", "FUSE", "INVESTIGATE", "REVIEW", "VALIDATE", "AUTHORIZE", "EXECUTE", "AUDIT"]
    },
    "actor_kind": {
      "type": "string",
      "enum": ["HUMAN", "DETECTOR", "SYSTEM", "AI", "EXECUTOR", "INTEGRATION", "ORCHESTRATOR", "C1_AI", "A1_AI", "L1_DETECTOR", "L2_DETECTOR", "L3_DETECTOR", "L4_DETECTOR", "R0", "DATA_STEWARD"]
    },
    "actor_id": { "type": "string" },
    "event_type": { "type": "string" },
    "severity": { "type": ["string", "null"] },
    "summary": { "type": "string", "description": "Steward-facing one-liner. Never raw chain-of-thought." },
    "payload_json": { "type": "object" },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string", "format": "date-time" },
    "correlation_id": { "type": "string" },
    "causation_id": { "type": ["string", "null"] },
    "provenance": {
      "type": ["string", "null"],
      "enum": ["real", "public", "semi-synthetic", "demo", "user_upload", null]
    }
  },
  "required": [
    "event_id",
    "sequence_number",
    "project_id",
    "phase",
    "actor_kind",
    "actor_id",
    "event_type",
    "summary",
    "created_at",
    "correlation_id"
  ]
}
