{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TargetSchema",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "dataset_name": { "type": "string" },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "dtype": { "type": "string" },
          "nullable": { "type": "boolean" },
          "description": { "type": "string" }
        },
        "required": ["name", "dtype"]
      }
    }
  },
  "required": ["version", "dataset_name", "columns"]
}
