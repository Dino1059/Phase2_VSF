OPENAI_API_KEY=your-openai-api-key-here
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini

# ---- Database ----
DATABASE_URL=postgresql://airflow:airflow@localhost:5432/airflow
AIRFLOW_UID=0

# Lane B keyed pseudonymization. Generate a long random value for each environment;
# never reuse the example or commit the real secret.
DATATRUST_PSEUDONYMIZATION_KEY=replace-with-a-long-random-secret
