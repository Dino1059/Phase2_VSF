# Tài khoản chủ sở hữu schema — chỉ dùng cho migration / seed
DATABASE_URL="postgresql://sod_owner:CHANGE_ME@localhost:5432/sod?schema=public"
# Tài khoản ứng dụng — không có quyền UPDATE/DELETE trên audit_log
APP_DATABASE_URL="postgresql://sod_app:CHANGE_ME@localhost:5432/sod?schema=public"

# Email (SMTP). Để trống SMTP_HOST thì mã xác nhận được in ra console của server (chỉ khi dev)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="SoD Flow <no-reply@sod.local>"

# Chỉ cho đăng ký bằng các tên miền này (cách nhau dấu phẩy). Trống = cho phép tất cả
ALLOWED_EMAIL_DOMAINS=""

# Mật khẩu tạm cho người dùng mẫu (bắt buộc đổi khi đăng nhập lần đầu)
SEED_PASSWORD="CHANGE_ME"
SEED_EMAIL_DOMAIN="sod.local"
