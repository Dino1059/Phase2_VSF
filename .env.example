# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- Primary LLM Provider (groq / openai / gemini / openrouter / ollama) ----
LLM_PROVIDER=groq

# ---- Groq (Recommended Free & Ultra-Fast: 30 RPM, 14.4k RPD) ----
# Get free key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- OpenAI (Backup) ----
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini

# ---- OpenRouter (Backup) ----
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_MODEL=openai/gpt-4o-mini

# ---- Google Gemini (Backup/Rotation) ----
# GOOGLE_API_KEY=your-gemini-key

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-api-key-here
AI_LOG_DIR=.ai-log

# ---- Sentry Monitoring ----
SENTRY_DSN=https://your-sentry-backend-dsn@sentry.io/12345
VITE_SENTRY_DSN=https://your-sentry-frontend-dsn@sentry.io/67890

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
